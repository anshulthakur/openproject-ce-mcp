# ==============================================================================
# OpenProject Community Edition MCP Server - Environment Configuration
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MCP Server Transport Configuration
# ------------------------------------------------------------------------------
# Transport protocol:
#   http  - Streamable HTTP transport listening on /mcp (default for container)
#   sse   - Server-Sent Events transport listening on /sse
#   stdio - Standard I/O (for direct CLI or 'docker run -i' execution)
TRANSPORT=http

# Host port to expose (the container internally listens on 8000)
PORT=8000

# Required for HTTP / SSE mode:
# Bearer token for client authentication (sent as 'Authorization: Bearer <token>'
# or query parameter '?token=<token>' / '?auth=<token>')
MCP_HTTP_TOKEN=your_secure_mcp_bearer_token_here

# ------------------------------------------------------------------------------
# 2. OpenProject Instance Connection
# ------------------------------------------------------------------------------
# Base URL of your OpenProject instance (e.g. https://192.168.1.50 or https://openproject.lan)
OPENPROJECT_BASE_URL=https://your-openproject.lan

# Personal API token (create in OpenProject under: My account -> Access tokens -> + API token)
OPENPROJECT_API_TOKEN=opapi-your-token-here

# Verify TLS certificates (set to false only if using self-signed certs on LAN)
OPENPROJECT_VERIFY_SSL=true

# API request timeout in seconds
OPENPROJECT_TIMEOUT=12

# ------------------------------------------------------------------------------
# 3. Project Scope (Security Boundary)
# ------------------------------------------------------------------------------
# Comma-separated project identifiers, names, or glob patterns (e.g. 'proj-1,team-*')
# '*' allows all visible projects. Empty denies all project-scoped reads.
OPENPROJECT_READ_PROJECTS=*

# Comma-separated list of projects permitted for write operations.
# Empty string disables all project mutations (read-only mode).
# Must be a subset of OPENPROJECT_READ_PROJECTS.
OPENPROJECT_WRITE_PROJECTS=

# ------------------------------------------------------------------------------
# 4. Core Tool Groups (Read/Write Visibility)
# ------------------------------------------------------------------------------
OPENPROJECT_ENABLE_PROJECT_READ=true
OPENPROJECT_ENABLE_PROJECT_WRITE=true
OPENPROJECT_ENABLE_WORK_PACKAGE_READ=true
OPENPROJECT_ENABLE_WORK_PACKAGE_WRITE=true
OPENPROJECT_ENABLE_MEMBERSHIP_READ=true
OPENPROJECT_ENABLE_MEMBERSHIP_WRITE=true
OPENPROJECT_ENABLE_VERSION_READ=true
OPENPROJECT_ENABLE_VERSION_WRITE=true
OPENPROJECT_ENABLE_BOARD_READ=true
OPENPROJECT_ENABLE_BOARD_WRITE=true
OPENPROJECT_ENABLE_MEETING_READ=true
OPENPROJECT_ENABLE_MEETING_WRITE=true

# ------------------------------------------------------------------------------
# 5. Opt-in Extended Tool Groups (Off by default)
# ------------------------------------------------------------------------------
# Personal preferences and notifications
OPENPROJECT_ENABLE_PERSONAL_READ=false
OPENPROJECT_ENABLE_PERSONAL_WRITE=false

# Instance-wide user/group management and storage administration (PII / Admin)
OPENPROJECT_ENABLE_ADMIN_READ=false
OPENPROJECT_ENABLE_ADMIN_WRITE=false

# Per-user vacation and working-hours schedules (OpenProject 17.3+)
OPENPROJECT_ENABLE_USER_SCHEDULE_READ=false
OPENPROJECT_ENABLE_USER_SCHEDULE_WRITE=false

# Rarely-needed metadata tools (query schemas, text rendering, help texts)
OPENPROJECT_ENABLE_EXTENDED_READ=false

# ------------------------------------------------------------------------------
# 6. Field Hiding & Context Limits
# ------------------------------------------------------------------------------
# Fields to omit from responses and reject on writes (comma-separated, wildcards allowed)
OPENPROJECT_HIDE_PROJECT_FIELDS=
OPENPROJECT_HIDE_WORK_PACKAGE_FIELDS=
OPENPROJECT_HIDE_ACTIVITY_FIELDS=
OPENPROJECT_HIDE_CUSTOM_FIELDS=

# Pagination and context token budget
OPENPROJECT_DEFAULT_PAGE_SIZE=10
OPENPROJECT_MAX_PAGE_SIZE=50
OPENPROJECT_MAX_RESULTS=100
OPENPROJECT_TEXT_LIMIT=500

# Logging level: CRITICAL, ERROR, WARNING, INFO, or DEBUG
OPENPROJECT_LOG_LEVEL=WARNING
